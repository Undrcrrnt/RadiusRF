<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RadiusRf" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <!-- Splash screen theme (Android 12+ SplashScreen API compat) -->
    <style name="Theme.RadiusRf.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_black</item>
        <item name="postSplashScreenTheme">@style/Theme.RadiusRf</item>
    </style>
</resources>
